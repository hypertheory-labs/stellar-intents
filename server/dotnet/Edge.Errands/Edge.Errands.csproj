<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- WHY: Errand's Apply methods are dispatched by code this generates, in this
             assembly. Fisher (and Marten) bundle it, so it used to come with Fisher; without
             a store package it has to be referenced directly, or startup fails. Private: an
             app's own aggregates get it from their store package.
             UPGRADING: keep this version equal to the JasperFx.Events that Wolverine and the
             stores use (2.87.1 now). Matching, and private, is "always safest" (Jeremy;
             unsettled/critter-stack-questions.md, #1). A mismatch may only show at startup. -->
        <PackageReference Include="JasperFx.Events.SourceGenerator" Version="2.87.1" PrivateAssets="all" />
        <PackageReference Include="WolverineFx" Version="6.50.2" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Edge.Errands.Tests" />
    </ItemGroup>

</Project>
